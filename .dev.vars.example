# Copy to .dev.vars for local development (never commit .dev.vars).
# Real keys work locally, or point the base URLs at the mock server (npm run mock:providers).

ELEVENLABS_API_KEY=your-elevenlabs-key
# Optional AI clean-up: wrangler.toml points it at Gemini, so this is your Gemini key again.
# OPENAI_API_KEY=your-gemini-key
# Handoff tab (SBAR reports). Without it, only the fixed example works.
# GEMINI_API_KEY=your-gemini-key
ADMIN_SETUP_CODE=choose-a-long-random-setup-code

# Uncomment to use the local mock providers instead of the real APIs (no cost):
# ELEVENLABS_BASE_URL=http://127.0.0.1:8790
# ENHANCE_BASE_URL=http://127.0.0.1:8790/v1
# OPENAI_API_KEY=mock
# GEMINI_API_KEY=mock
# GEMINI_BASE_URL=http://127.0.0.1:8790
